{
  "name": "photo-pinboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run icons:generate && vite build",
    "test": "node --test src/geo.test.js src/folders.test.js src/library.test.js src/metadata.test.js src/jpeg.test.js src/file-writing.test.js src/media.test.js src/capture-writing.test.js",
    "preview": "vite preview --host 127.0.0.1",
    "desktop:install": "node scripts/install-electron.cjs",
    "desktop:start": "npm run build && electron .",
    "desktop:package": "npm run build && node scripts/package-desktop.cjs",
    "desktop:smoke": "npm run build && electron . --pinboard-smoke-test",
    "test:desktop": "node --test desktop/core.test.cjs desktop/video.test.cjs",
    "icons:generate": "node scripts/generate-icons.cjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "exifr": "^7.1.3",
    "hash-wasm": "^4.12.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.1",
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^45.0.0",
    "resedit": "^3.1.1",
    "vite": "^6.1.0",
    "yazl": "^3.3.1"
  },
  "productName": "Photo Pinboard",
  "description": "Local photo and video geotagging and capture-date repair",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "author": "blissfulsaint",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/blissfulsaint/photo-pinboard.git"
  },
  "bugs": {
    "url": "https://github.com/blissfulsaint/photo-pinboard/issues"
  },
  "homepage": "https://github.com/blissfulsaint/photo-pinboard#readme"
}
